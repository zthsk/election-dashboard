# Backend
DB_PATH=backend/data/elections/2082/state.db
CORS_ALLOW_ORIGINS=*
API_CACHE_CONTROL=public, s-maxage=15, stale-while-revalidate=30
STALE_THRESHOLD_SECONDS=600
DEFAULT_ELECTION_ID=2082

# Poller
ACTIVE_ELECTIONS=2082,2079
POLL_INTERVAL_SECONDS=45
POLL_STAGGER_SECONDS=1
HTTP_TIMEOUT_SECONDS=20
INGEST_USER_AGENT=ElectionPoller/1.0
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_BASE=/api
